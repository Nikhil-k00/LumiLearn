# ─── DysLex AI — Backend environment variables ────────────────────────────────
# Copy this file to .env and fill in the values before running.
# Never commit the real .env file.

# Required — MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/dyslex?retryWrites=true&w=majority

# Required — Secret used to sign JWT tokens (use a long random string)
JWT_SECRET=

# Required — OpenAI API key (used only if backend calls OpenAI directly)
OPENAI_API_KEY=

# Required — Internal URL of the FastAPI AI service
AI_SERVICE_URL=http://localhost:8000

# Required — Allowed frontend origin for CORS
FRONTEND_URL=http://localhost:3000

# Optional — Cloudinary credentials for avatar image uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional — Server port (defaults to 5000)
PORT=5000

# Optional — Set to "production" on Render
NODE_ENV=development
