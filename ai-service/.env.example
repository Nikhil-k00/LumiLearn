# ─── DysLex AI — AI Service environment variables ─────────────────────────────
# Copy this file to .env and fill in the values before running.
# Never commit the real .env file.

# Required — OpenAI API key used by the AI orchestration agents
OPENAI_API_KEY=

# Required — URL of the Express backend (used for CORS allow-list)
BACKEND_URL=http://localhost:5000
